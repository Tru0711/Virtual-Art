NODE_ENV=production
PORT=5000
HOST=0.0.0.0
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://virtual-art-psi.vercel.app
CORS_ORIGINS=https://virtual-art-psi.vercel.app

# Cloudinary configuration for permanent image storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Brevo SMTP configuration for OTP, verification, and password reset emails
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_SECURE=false
BREVO_SMTP_USER=your-brevo-login@example.com
BREVO_SMTP_PASS=your-brevo-smtp-key
BREVO_SMTP_FROM="Virtual Art Gallery" <noreply@yourdomain.com>

# Mailer safety settings
SMTP_SEND_TIMEOUT_MS=8000
SMTP_VERIFY_TIMEOUT_MS=10000
EMAIL_DEDUPE_WINDOW_MS=10000

# OTP / reset settings
OTP_EXPIRY_MINUTES=10
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3
RESET_SESSION_EXPIRES_MINUTES=10
RESET_EXPIRE_MINUTES=15

# For Atlas: Add 0.0.0.0/0 in Network Access to allow connections from any IP